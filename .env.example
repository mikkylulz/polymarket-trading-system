# Copy to .env. Paper mode runs with every value below left empty.

# Telegram alerts (optional in paper mode; alerts fall back to the log)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Visual Crossing, used to cross-check actual temperatures (optional in paper mode)
VC_API_KEY=

# Polymarket CLOB credentials (live trading only)
PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PROXY_WALLET=

# Live-mode toggles per bot (default false = paper)
BTC_LIVE_MODE=false
SOL_LIVE_MODE=false
BTC_15M_LIVE_MODE=false
SOL_15M_LIVE_MODE=false
BTC_1H_LIVE_MODE=false

# Pause switches
WEATHER_PAUSED=false
ELON_PAUSED=true
